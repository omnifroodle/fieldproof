# Copy to .env (git-ignored) and fill in. See README.
# Capella cluster: a database credential with READ access on the bucket is enough for the dashboard.
CB_CONN_STR=couchbases://cb.YOUR-ID.cloud.couchbase.com
CB_USERNAME=
CB_PASSWORD=
CB_BUCKET=demos
# App Services Public REST (port 4984), used as the supervisor app user. No admin credential is needed.
APPSERVICES_URL=https://YOUR-ID.apps.cloud.couchbase.com:4984
APPSERVICES_ENDPOINT=fieldproof
APPSERVICES_USER=supervisor
APPSERVICES_PASSWORD=
PORT=3000
